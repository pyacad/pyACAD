<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pyACAD runtime: ribbon injection, engines, bundles, output window.
    Deployed beside the loader but never loaded by AutoCAD directly; found by the
    loader's AssemblyResolver. IronPython and all future dependencies live here.
  -->

  <PropertyGroup>
    <AssemblyName>PyAcad.Runtime</AssemblyName>
    <RootNamespace>PyAcad.Runtime</RootNamespace>
    <OutputType>Library</OutputType>
    <OutputPath>$(PyAcadBinRoot)runtime\</OutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ReferencesAcadApi>true</ReferencesAcadApi>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IronPython" Version="3.4.2" />
    <!-- Python standard library, copied to <output>\lib\ -->
    <PackageReference Include="IronPython.StdLib" Version="3.4.2" />
    <!-- CPython hosting; the interpreter itself comes from the user's machine -->
    <PackageReference Include="pythonnet" Version="3.0.5" />
    <!-- HTML output window; needs the Evergreen WebView2 runtime on the machine -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- config.json, secrets.json, AI provider payloads -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- DPAPI (ProtectedData) for the encrypted secrets.json -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- HttpClient for the AI providers (part of the shared framework on net8) -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the command line, which the installer runs to protect users' work -->
    <Compile Include="..\Shared\ShippedFiles.cs" Link="Upgrade\ShippedFiles.cs" />
    <Compile Include="..\Shared\MachineFolderTrust.cs" Link="Install\MachineFolderTrust.cs" />
    <!-- Shared with the command line: where each AutoCAD release is installed -->
    <Compile Include="..\Shared\AcadInstall.cs" Link="Host\AcadInstall.cs" />
    <!-- Shared with the command line, which hands pyacad run requests to the runner -->
    <Compile Include="..\Shared\RunContract.cs" Link="Execution\Runner\RunContract.cs" />
    <Compile Include="..\Shared\JsonShapes.cs" Link="Config\JsonShapes.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AI panel's system prompt, generated by tools/build_authoring_pack.py -->
    <None Update="Ai\authoring-pack.md" Link="authoring-pack.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PyAcad.Tests" />
  </ItemGroup>

</Project>
